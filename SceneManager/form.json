{
    "elements": [
        {
            "type": "ExpansionPanel",
            "caption": "Szenenkonfiguration",
            "items": [
                {
                    "type": "Label",
                    "caption": "Jede Szene enthält ihre eigenen Geräte. Geräte und Zielwerte werden in der HTML-Kachel ausgewählt."
                },
                {
                    "type": "List",
                    "name": "Scenes",
                    "caption": "Szenen",
                    "rowCount": 6,
                    "add": true,
                    "delete": true,
                    "changeOrder": true,
                    "columns": [
                        {
                            "name": "id",
                            "caption": "Szenen-ID",
                            "width": "80px",
                            "add": 1,
                            "edit": {
                                "type": "NumberSpinner",
                                "minimum": 1
                            }
                        },
                        {
                            "name": "name",
                            "caption": "Szenenname",
                            "width": "220px",
                            "add": "Neue Szene",
                            "edit": {
                                "type": "ValidationTextBox"
                            }
                        },
                        {
                            "name": "icon",
                            "caption": "Icon",
                            "width": "140px",
                            "add": "🎬",
                            "edit": {
                                "type": "ValidationTextBox"
                            }
                        },
                        {
                            "name": "createSaveVariable",
                            "caption": "Speichern-Variable in Visu",
                            "width": "180px",
                            "add": false,
                            "edit": {
                                "type": "CheckBox"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Optionen & Visualisierung",
            "items": [
                {
                    "type": "CheckBox",
                    "name": "UseHTMLTile",
                    "caption": "HTML-SDK Kachel in Visualisierung aktivieren"
                },
                {
                    "type": "NumberSpinner",
                    "name": "SwitchDelay",
                    "caption": "Schaltverzögerung zwischen Geräten (ms)",
                    "minimum": 0,
                    "maximum": 5000,
                    "suffix": "ms"
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "NumberSpinner",
                    "name": "TestSceneID",
                    "caption": "Szenen-ID für Test",
                    "value": 1
                },
                {
                    "type": "Button",
                    "caption": "Szene ausführen",
                    "onClick": "SM_ExecuteScene($id, $TestSceneID);"
                },
                {
                    "type": "Button",
                    "caption": "Live-Werte der Szenengeräte speichern",
                    "onClick": "SM_SaveScene($id, $TestSceneID);"
                }
            ]
        }
    ]
}

